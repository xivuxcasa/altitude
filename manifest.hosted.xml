<?xml version="1.0" encoding="UTF-8"?>
<!-- Altitude: hosted manifest. Served from https://xivuxcasa.github.io/altitude -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>458ea827-d584-4314-b7b8-f13e0d472507</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Juan</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Altitude"/>
  <Description DefaultValue="Helicopter view of your inbox: group tiles by person, client, topic and smart filters."/>
  <IconUrl DefaultValue="https://xivuxcasa.github.io/altitude/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://xivuxcasa.github.io/altitude/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://xivuxcasa.github.io/altitude/taskpane.html"/>
  <AppDomains>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://xivuxcasa.github.io/altitude/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="altitudeGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="altitudeOpenPane">
                    <Label resid="Pane.Label"/>
                    <Supertip>
                      <Title resid="Pane.Label"/>
                      <Description resid="Pane.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Pane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://xivuxcasa.github.io/altitude/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://xivuxcasa.github.io/altitude/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://xivuxcasa.github.io/altitude/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Pane.Url" DefaultValue="https://xivuxcasa.github.io/altitude/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Altitude"/>
          <bt:String id="Pane.Label" DefaultValue="Helicopter view"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Pane.Tooltip" DefaultValue="See your inbox from above, grouped by person, client, topic and smart filters."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
